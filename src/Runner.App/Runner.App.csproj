<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF0001: the Fluent theme's ThemeMode is marked experimental. The others are naming / style rules the engine project
         leaves out too (its a_ parameter names, a WPF override's parameter names), never a resource, speed or correctness rule -->
    <NoWarn>$(NoWarn);WPF0001;CA1707;CA1401;CA1720;CA1725</NoWarn>
    <AssemblyName>Tool Runner</AssemblyName>
    <RootNamespace>ToolRunner.App</RootNamespace>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- its own Main (Program.cs): a command runs without WPF ever starting; the window starts it -->
    <StartupObject>ToolRunner.App.Program</StartupObject>
    <Version>1.0.0</Version>
    <Authors>izzydoingit</Authors>
    <Product>Tool Runner</Product>
    <Description>Runs Mod Organizer 2's generators in the right order, unattended, and puts the profile back.</Description>
    <Copyright>izzydoingit - GPL-3.0-or-later</Copyright>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- a small program that mostly waits: no second collector thread and no profile-guided re-compiling held in memory
         (measured: about 2.4 MB less private memory, nothing slower that can be seen) -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Logo.png" />
    <EmbeddedResource Include="Theme template.json" LogicalName="ThemeTemplate.json" />
    <!-- the shipped themes, each the same file a player's own theme is -->
    <EmbeddedResource Include="Themes\*.json" LogicalName="Theme.%(Filename).json" />
    <!-- The shipped languages: { "the English words": "their translation" } each. As plain text they were a third of the
         program file (a one-file program that needs the runtime is not compressed when it is published): they go in as one
         packed file, made when the program is built (the PackLanguages target), and only the language in use is unpacked -->
    <LanguageFile Include="Languages\*.json" />
    <EmbeddedResource Include="$(IntermediateOutputPath)Languages.zip" LogicalName="Languages.zip" Visible="false" />
  </ItemGroup>

  <Target Name="PackLanguages" BeforeTargets="AssignTargetPaths" Inputs="@(LanguageFile)" Outputs="$(IntermediateOutputPath)Languages.zip">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ZipDirectory SourceDirectory="$(MSBuildProjectDirectory)\Languages" DestinationFile="$(IntermediateOutputPath)Languages.zip" Overwrite="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Runner.Core\Runner.Core.csproj" />
  </ItemGroup>

</Project>
